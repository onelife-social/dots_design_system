{
  "name": "@dots/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Dots. Memories design system \u2014 React implementation. Source of truth for the web/Claude Design bundle; the Dart package at the repo root is the Flutter implementation.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/foundations/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build": "npm run build:bundle && npm run typecheck"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
